ingV2\n\n        ...LiveVideo\n        ...WatchedVideo\n\n        ...LiveEventTaglines @include(if: $isLiveEpisodic)\n\n        ...PreviewModalArtworkBoxart @skip(if: $fetchPromoVideoOverride)\n        ...PreviewModalArtworkBoxartHighRes @skip(if: $fetchPromoVideoOverride)\n        ...PreviewModalArtworkLiveNowBoxart @skip(if: $isLiveEpisodic)\n        ...PreviewModalArtworkEpisodicLiveImagesTimeline @include(if: $isLiveEpisodic)\n        ...PreviewModalArtworkLogo\n        ...PreviewModalArtworkStoryArt\n        ...PreviewModalPlayableVideo\n        ...PreviewModalVideoAvailability\n        ...PreviewModalVideoButtonControls\n\n        ...PreviewModalPromoVideo @skip(if: $hasPromoVideoOverride)\n    }\n":a.PreviewModalVideoMerchPlayerFragmentDoc,"#graphql\n    fragment PreviewModalVideoMiniModal on Video {\n        videoId\n        title\n        contentWarning {\n            message\n        }\n\n        ...LiveVideo\n        ...ResumableVideo\n        ...VideoBadging\n        ...WatchedVideo\n\n        ...MiniModalVideoEvidence\n        ...PreviewModalVideoAvailability\n        ...PreviewModalVideoButtonControls \n        ...PreviewModalVideoMetadata \n        ...PreviewModalVideoMostLiked \n        ...PreviewModalVideoSupplementalMessage \n    }\n":a.PreviewModalVideoMiniModalFragmentDoc,"#graphql\n    fragment VideoPlaylistButton on Video {\n        videoId\n\n        title\n        isPlayable\n        isAvailable\n        unplayableCauses\n\n\n        ...VideoPlaylist\n    }\n":a.VideoPlaylistButtonFragmentDoc,"#graphql\n    fragment GamePlaylistButton on Game {\n        gameId\n        ...GamePlaylist\n    }\n":a.GamePlaylistButtonFragmentDoc,"#graphql\nquery EpisodeTaglineDataQuery(\n    $entityId: ID!,\n    $textEvidenceUiContext: TextEvidenceUiContext! = SECTION_ENTITY\n) {\n    unifiedEntities(unifiedEntityIds: [$entityId]) {\n        unifiedEntityId\n\n        ...LiveEventTaglines\n    }\n}\n":a.EpisodeTaglineDataQueryDocument,"\nquery GetGamesHandleAvailability($handle: String) {\n    upiHandleAvailability(handle: $handle) {\n        ... on UPIHandleAvailable {\n            __typename\n            localizedDescription {\n                value\n            }\n        }\n        ... on UPIHandleUnavailableError {\n            __typename\n            localizedDescription {\n                value\n            }\n        }\n    }\n}\n":a.GetGamesHandleAvailabilityDocument,"\nmutation SetHandle($handle: String!, $profileGuid: String) {\n    upiSetHandle(handle: $handle, profileGuid: $profileGuid) {\n        ... on UPISetHandleSuccess {\n            __typename\n            handle {\n                fullHandle\n            }\n        }\n        ... on UPIHandleModerationError {\n            __typename\n            alert {\n                errorCode\n            }\n            localizedDescription {\n                value\n            }\n        }\n        ... on UPIHandleUnavailableError {\n            __typename\n            alert {\n                errorCode\n            }\n            localizedDescription {\n                value\n            }\n        }\n        ... on UPIHandleValidationError {\n            __typename\n            alert {\n                errorCode\n            }\n            localizedDescription {\n                value\n            }\n        }\n    }\n}\n":a.SetHandleDocument,"\nmutation SuggestHandle($prefetch: Boolean!) {\n  ngpPlayer_suggestHandle(prefetch: $prefetch) {\n    ... on NGPPlayer_SuggestedHandle {\n      __typename\n      handle\n      nextAvailableAfterMillis\n    }\n    ... on NGPPlayer_HandleSuggestionsPoolExhaustedError {\n      __typename\n      message\n    }\n    ... on NGPPlayer_SuggestHandleThottledError {\n      __typename\n      message\n    }\n  }\n}\n":a.SuggestHandleDocument,"\n    query GetGameDetails($gameId: Int!) {\n        games(gameIds: [$gameId]) {\n            gameId\n            title\n            protected {\n                isPreReleasePinProtected\n            }\n            artworkSmall: artwork(\n                params: {\n                    artworkType: LOGO_BRANDED_STACKED\n                    dimension: { width: 600 }\n                }\n            ) {\n                key\n                url\n                width\n                height\n            }\n            artworkLarge: artwork(\n                params: {\n                    artworkType: LOGO_STACKED_CROPPED\n                    dimension: { width: 800 }\n                }\n            ) {\n                key\n                url\n                width\n                height\n            }\n        }\n    }\n":a.GetGameDetailsDocument,"\n    query GetUserProfile($gameId: Int!) {\n        currentProfile {\n            guid\n            name\n            avatar(dimension: AVATAR_SIZE_34) {\n                key\n                url\n                width\n                height\n            }\n            publicIdentity {\n                handle {\n                    fullHandle\n                }\n            }\n            publicIdentityConfiguration {\n                ... on UPIConfiguration {\n                    __typename\n                    handleConfiguration {\n                        ... on UPIHandleConfiguration {\n                            __typename\n                            handleMinLength\n                            handleMaxLength\n                            handlePattern\n                            isHandleRequired(input: { gameId: $gameId })\n                        }\n                    }\n                }\n            }\n        }\n    }\n":a.GetUserProfileDocument,"\n    mutation CreateGameControllerBeacon(\n        $gameId: Int!\n        $gameplaySessionId: ID!\n        $cloudGameToken: String!\n    ) {\n        ngpCreateBeacon(\n            gameId: $gameId\n            gameType: CLOUD_GAME\n            gameplaySessionId: $gameplaySessionId\n            cloudGameToken: $cloudGameToken\n        ) {\n            id\n            code\n            qrCodeUrl\n            validUntil\n        }\n    }\n":a.CreateGameControllerBeaconDocument,"\n    mutation ExtendGameControllerBeacon(\n        $gameId: Int!\n        $gameplaySessionId: ID!\n        $beaconCode: String!\n        $minutesToExtend: Int!\n    ) {\n        ngpExtendBeaconValidUntil(\n            gameId: $gameId\n            gameplaySessionId: $gameplaySessionId\n            beaconCode: $beaconCode\n            minutesToExtend: $minutesToExtend\n        ) {\n            success\n        }\n    }\n":a.ExtendGameControllerBeaconDocument,"\n    mutation CloseGameControllerBeacon($beaconId: ID!) {\n        ngpCloseBeacon(beaconId: $beaconId) {\n            id\n        }\n    }\n":a.CloseGameControllerBeaconDocument,"#graphql\n    fragment PauseAdsArtworkLogoArt on Video {\n        videoId\n        logoArt: artwork(\n            params: {\n                artworkType: LOGO_BRANDED_STACKED_ROAR\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":a.PauseAdsArtworkLogoArtFragmentDoc,"#graphql\n    fragment PauseAdsArtworkTitleArt on Video {\n        videoId\n        titleArt: artwork(\n            params: {\n                artworkType: VERTICAL_STORY_ART\n                dimension: {height: 600}\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":a.PauseAdsArtworkTitleArtFragmentDoc,"#graphql \n    fragment DisplayAdOpportunity on PinotDisplayAdOpportunityEvents {\n        opportunity {\n            token\n        }\n    }\n":a.DisplayAdOpportunityFragmentDoc,"#graphql \n    fragment DisplayAdContent on PinotDisplayAdContent {\n        uri\n        ctaUrl\n        ctaUrlTitle\n        adEvents {\n            start {\n                token\n            }\n            progress {\n                token\n            }\n            complete {\n                token\n            }\n            error {\n                token\n            }\n        }\n    }\n":a.DisplayAdContentFragmentDoc,"#graphql \n    fragment PinotPausedPlaybackAdEntityTreatment on PinotPausedPlaybackAdEntityTreatment {\n        displayAd(imageRecipe: $imageRecipeForPausedPlaybackBackground, playbackContextId: $playbackContextId) {\n            opportunityEvents {\n                ...DisplayAdOpportunity\n            }\n            content {\n                ...DisplayAdContent\n            }\n        }\n    }\n":a.PinotPausedPlaybackAdEntityTreatmentFragmentDoc,"#graphql\n    fragment PinotSectionConnection on PinotSectionConnection {\n        edges {\n            cursor\n            node {\n                ... on PinotSingleItemSection { \n                    sectionId\n                    entity {\n                       ...PinotPausedPlaybackAdEntityTreatment\n                    }\n                }\n            }\n        }\n        totalCount\n        pageInfo {\n            startCursor\n            endCursor\n        }\n        \n    }\n":a.PinotSectionConnectionFragmentDoc,"#graphql\n    fragment PinotPausedPlaybackAdPage on PinotPausedPlaybackAdPage {\n        adPageSections: sections {\n            ...PinotSectionConnection\n        }\n    }\n":a.PinotPausedPlaybackAdPageFragmentDoc,"#graphql\n    query PauseAdsArtwork(\n        $videoIds: [Int!]!,\n        $unifiedEntityId: ID,\n        $playbackContextId: ID,\n        $options: PinotPausedPlaybackRequestOptionsInput,\n        $imageRecipeForPausedPlaybackBackground: PinotDisplayAdImageRecipeInput!\n    ) {\n        pinotPausedPlaybackPage(unifiedEntityId: $unifiedEntityId, options: $options) {\n            ...PinotPausedPlaybackAdPage\n        }\n        videos(videoIds: $videoIds) {\n            videoId,\n            ...PauseAdsArtworkTitleArt\n            ...PauseAdsArtworkLogoArt\n        }\n    }\n":a.PauseAdsArtworkDocument,"\n    mutation AcceptFriendshipInvitation($senderId: ID!) {\n        ngpFriendship_acceptInvitation(input: { senderId: $senderId }) {\n            ... on NGPFriendship_AcceptInvitationSuccess {\n                senderId\n            }\n            ... on NGPFriendship_InvitationNotFoundError {\n                description\n            }\n            ... on NGPFriendship_AcceptInvitationError {\n                description\n            }\n        }\n    }\n":a.AcceptFriendshipInvitationDocument,"\n    mutation BlockPlayer($userId: ID!) {\n        ngpPlayerPrivacy_addPlayerBlock(input: { playerId: $userId }) {\n            ... on NGPPlayerPrivacy_AddPlayerBlockSuccess {\n                blockedId\n            }\n            ... on NGPPlayerPrivacy_SelfPlayerBlockError {\n                description\n            }\n            ... on NGPPlayerPrivacy_DuplicatePlayerBlockError {\n                description\n            }\n            ... on NGPPlayerPrivacy_PlayerToBeBlockedNotFoundError {\n                description\n            }\n        }\n    }\n":a.BlockPlayerDocument,"\n    query GetPlayerCard($userId: ID) {\n        ngpPlayer(input: { id: $userId }) {\n            ... on NGPPlayer {\n                id\n                publicIdentity {\n                    handle {\n                        fullHandle\n                    }\n                }\n                profileIcon(input: { size: SQUARE_100 }) {\n                    ... on NGPPlayer_ProfileIcon {\n                        url\n                        dominantBackgroundColor\n                    }\n                    ... on NGPPlayer_ProfileIconUnavailableError {\n                        message\n                    }\n                }\n                presence {\n                    status\n                    activeAt\n                    app {\n                        game {\n                            gameId\n                            title\n                        }\n                    }\n                }\n                block {\n                    status\n                }\n                friendship {\n                    status\n                }\n                socialEvidence {\n                    type\n                }\n            }\n            ... on NGPPlayerNotFoundError {\n                playerId\n                localizedDescription {\n                    value\n                }\n            }\n            ... on NGPPlayerLookupError {\n                playerId\n                localizedDescription {\n                    value\n                }\n            }\n        }\n    }\n":a.GetPlayerCardDocument,"\n    mutation RejectFriendshipInvitation($senderId: ID!) {\n        ngpFriendship_rejectInvitation(input: { senderId: $senderId }) {\n            ... on NGPFriendship_RejectInvitationSuccess {\n                senderId\n            }\n            ... on NGPFriendship_InvitationNotFoundError {\n                description\n            }\n            ... on NGPFriendship_RejectInvitationError {\n                description\n            }\n        }\n    }\n":a.RejectFriendshipInvitationDocument,"\n    mutation RemoveFriend($userId: ID!) {\n        ngpFriendship_removeFriend(input: { playerId: $userId }) {\n            ... on NGPFriendship_RemoveFriendSuccess {\n                playerId\n            }\n            ... on NGPFriendship_RemoveFriendError {\n                description\n            }\n            ... on NGPFriendship_RemoveFriendError {\n                description\n            }\n        }\n    }\n":a.RemoveFriendDocument,"\n    mutation SendFriendshipInvitation($userId: ID!) {\n        ngpFriendship_sendInvitation(input: { receiverId: $userId }) {\n            ... on NGPFriendship_SendInvitationSuccess {\n                receiverId\n            }\n            ... on NGPFriendship_DuplicateInvitationError {\n                description\n            }\n            ... on NGPFriendship_FriendshipAlreadyExistsError {\n                description\n            }\n            ... on NGPFriendship_InvitedPlayerBlockedError {\n                description\n            }\n            ... on NGPFriendship_InvitedPlayerNotFoundError {\n                description\n            }\n            ... on NGPFriendship_SendInvitationError {\n                description\n            }\n        }\n    }\n":a.SendFriendshipInvitationDocument,"\n    mutation UnblockPlayer($userId: ID!) {\n        ngpPlayerPrivacy_removePlayerBlock(input: { playerId: $userId }) {\n            ... on NGPPlayerPrivacy_RemovePlayerBlockSuccess {\n                unblockedId\n            }\n            ... on NGPPlayerPrivacy_PlayerBlockNotFoundError {\n                description\n            }\n        }\n    }\n":a.UnblockPlayerDocument,"\n    mutation WithdrawFriendshipInvitation($userId: ID!) {\n        ngpFriendship_withdrawInvitation(input: { receiverId: $userId }) {\n            ... on NGPFriendship_WithdrawInvitationSuccess {\n                receiverId\n            }\n            ... on NGPFriendship_InvitationNotFoundError {\n                description\n            }\n            ... on NGPFriendship_WithdrawInvitationError {\n                description\n            }\n        }\n    }\n":a.WithdrawFriendshipInvitationDocument,"\n    query SuggestedFriendsList {\n        ngpCurrentPlayer {\n            friendshipRecommendations {\n                player {\n                    id\n                    publicIdentity {\n                        handle {\n                            fullHandle\n                        }\n                    }\n                    profileIcon(input: { size: SQUARE_50 }) {\n                        ... on NGPPlayer_ProfileIcon {\n                            url\n                            dominantBackgroundColor\n                        }\n                        ... on NGPPlayer_ProfileIconUnavailableError {\n                            message\n                        }\n                    }\n                }\n                recommendationReason\n            }\n        }\n    }\n":a.SuggestedFriendsListDocument,"\n    query BlockedListRoute {\n        ngpCurrentPlayer {\n            id\n            blocks {\n                player {\n                    id\n                    publicIdentity {\n                        handle {\n                            fullHandle\n                        }\n                    }\n                    profileIcon(input: { size: SQUARE_50 }) {\n                        ... on NGPPlayer_ProfileIcon {\n                            url\n                            dominantBackgroundColor\n                        }\n                        ... on NGPPlayer_ProfileIconUnavailableError {\n                            message\n                        }\n                    }\n                }\n            }\n        }\n    }\n":a.BlockedListRouteDocument,"\n    query FriendsListRoute {\n        ngpCurrentPlayer {\n            id\n            friendships {\n                player {\n                    id\n                    publicIdentity {\n                        handle {\n                            fullHandle\n                        }\n                    }\n                    profileIcon(input: { size: SQUARE_50 }) {\n                        ... on NGPPlayer_ProfileIcon {\n                            url\n                            dominantBackgroundColor\n                        }\n                        ... on NGPPlayer_ProfileIconUnavailableError {\n                            message\n                        }\n                    }\n                    presence {\n                        status\n                        app {\n                            type\n                            title\n                        }\n                    }\n                }\n            }\n            friendshipReceivedInvitations {\n                sender {\n                    id\n                    publicIdentity {\n                        handle {\n                            fullHandle\n                        }\n                    }\n                    profileIcon(input: { size: SQUARE_50 }) {\n                        ... on NGPPlayer_ProfileIcon {\n                            url\n                            dominantBackgroundColor\n                        }\n                        ... on NGPPlayer_ProfileIconUnavailableError {\n                            message\n                        }\n                    }\n                }\n            }\n        }\n    }\n":a.FriendsListRouteDocument,"\n    query GetPlayerPresence($userId: ID) {\n        ngpPlayer(input: { id: $userId }) {\n            ... on NGPPlayer {\n                id\n                publicIdentity {\n                    handle {\n                        fullHandle\n                    }\n                }\n                profileIcon(input: { size: SQUARE_50 }) {\n                    ... on NGPPlayer_ProfileIcon {\n                        url\n                        dominantBackgroundColor\n                    }\n                    ... on NGPPlayer_ProfileIconUnavailableError {\n                        message\n                    }\n                }\n                presence {\n                    status\n                    app {\n                        type\n                        title\n                    }\n                }\n            }\n        }\n    }\n":a.GetPlayerPresenceDocument,"\n    query PrivacySettingsRoute {\n        ngpCurrentPlayer {\n            privacySettings {\n                settings {\n                    id\n                    scope\n                }\n            }\n        }\n    }\n":a.PrivacySettingsRouteDocument,"\n    mutation UpdatePrivacySettings(\n        $setting: ID!\n        $scope: NGPPlayerPrivacy_SettingScope!\n    ) {\n        ngpPlayerPrivacy_updatePrivacySetting(\n            input: { setting: $setting, scope: $scope }\n        ) {\n            ... on NGPPlayerPrivacy_UpdatePrivacySettingSuccess {\n                setting\n            }\n            ... on NGPPlayerPrivacy_UpdatePrivacySettingError {\n                description\n            }\n        }\n    }\n":a.UpdatePrivacySettingsDocument,"\n    mutation saveConnectionIntent($osVersion: String!, $code: String!) {\n        ngpStoreDeepLinkInfo(osVersion: $osVersion, beaconCode: $code) {\n            success\n        }\n    }\n":a.saveConnectionIntentDocument,"\n    query GamePlayableQuery($gameIds:[Int!]!) {\n        games(gameIds: $gameIds) {\n            isPlayable\n            deviceCategories\n        }\n    }\n":a.GamePlayableQueryDocument,"\n    query NonmemberQuery1(\n        $videoId: Int!\n        $opaqueImageFormat: ArtworkFormat!\n        $transparentImageFormat: ArtworkFormat!\n    ) {\n        trifectaRows: growthVideoCollections(\n            collectionsInput: {\n                collectionInputs: [{ collectionType: TRENDING_NOW, limit: 10 }]\n            }\n        ) {\n            __typename\n            collections {\n                ...TitleRowFragment\n            }\n        }\n        videos(videoIds: [$videoId]) {\n            # __typename and videoId is required for the generated queries to work.\n            __typename\n            videoId\n            title\n            ...LodpTrailers\n            # MoreDetailsFragment is globally available via the generated queries harness in Shakti and is defined in\n            # MoreDetails.tsx\n            ...MoreDetailsFragment\n            ...LodpHero\n            ...MoreLikeThisFragment\n            ...LodpPageBackgroundFragment\n            ...MetadataLodpFragment\n            ...EpisodesSectionFragment\n        }\n        plans: growthPlans {\n            ...LodpHeroPlans\n            ...Plans\n        }\n    }\n":a.NonmemberQuery1Document,"\n    query LodpClipsAndExtras($videoId: Int!) {\n        videos(videoIds: [$videoId]) {\n            ... on Supplemental {\n                videoId\n                title\n                playableVideo(\n                    request: { encodingProfiles: NODRM_H264BPL30_HEAAC_MP4 }\n                ) {\n                    url\n                }\n            }\n        }\n    }\n":a.LodpClipsAndExtrasDocument,"\n    fragment MoreLikeThisFragment on Video {\n        similarVideos {\n            videoId\n            ...TitleRowElementModalFragment\n            ...TitleRowElementBoxshotFragment\n        }\n    }\n":a.MoreLikeThisFragmentFragmentDoc,"\n    fragment EpisodeFragment on Episode {\n        videoId\n        title\n        runtimeSec\n        shortSynopsis\n        number\n        ...MerchStill300\n    }\n":a.EpisodeFragmentFragmentDoc,"\n    fragment EpisodesSectionFragment on Video {\n        ... on Show {\n            seasons {\n                pageInfo {\n                    hasNextPage\n                }\n                edges {\n                    node {\n                        videoId\n                        numberLabelV2(label: LONG)\n                        shortTitle\n                        title\n                        totalDisplayRuntimeInSec\n                        showMemberType\n                        episodes {\n                            pageInfo {\n                                hasNextPage\n                            }\n                            edges {\n                                node {\n                                    videoId\n                                    ...EpisodeFragment\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n":a.EpisodesSectionFragmentFragmentDoc,"\n    fragment BillboardVideoFragment on Supplemental {\n        __typename,\n        ...SupplementalPlayableVideoFragment\n    }\n":a.BillboardVideoFragmentFragmentDoc,"\n    fragment LodpHero on Video {\n        videoId\n        __typename\n        ...LodpHeroPromoFragment\n        ...HeroContentFragment\n        ...LodpHeroImages\n    }\n":a.LodpHeroFragmentDoc,"\n    fragment LodpHeroPromoFragment on Video {\n        __typename\n        promoVideo(context: {\n            u